//   --// waybar config generated by wbarconfgen.sh //--   //
//
//   OJO: editado a mano. wbarconfgen.sh no esta instalado en este sistema,
//   asi que este archivo NO se va a regenerar solo. Backup en
//   ~/.config/waybar-backup-20260818/

{
    // sourced from header module //

        "layer": "top",
        "output": [ "DP-2" ],
        "position": "top",
        "mod": "dock",
        "height": 38,
        "exclusive": true,
        "passthrough": false,
        "gtk-layer-shell": true,
        "reload_style_on_change": true,
    
    
    // positions generated based on config.ctl //
    
        "modules-left": ["custom/padd","custom/l_end","cpu","memory","custom/cpuinfo","custom/gpuinfo#nvidia","custom/r_end","custom/l_end","niri/workspaces","custom/r_end","custom/l_end","niri/window","custom/r_end","custom/padd"],
        "modules-center": ["custom/padd","custom/l_end","idle_inhibitor","clock","custom/r_end","custom/padd"],
        "modules-right": ["custom/padd","custom/l_end","network","pulseaudio","pulseaudio#microphone","custom/updates","custom/keybindhint","custom/r_end","custom/l_end","privacy","tray","custom/r_end","custom/l_end","custom/cliphist","custom/power","custom/r_end","custom/padd"],
    
    
    // sourced from modules based on config.ctl //
    
        "cpu": {
            "interval": 10,
            "format": "󰍛 {usage}%",
            "rotate": 0,
            "format-alt": "{icon0}{icon1}{icon2}{icon3}",
            "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"]
        },
    
        "memory": {
            "states": {
                "c": 90, // critical
                "h": 60, // high
                "m": 30, // medium
            },
            "interval": 30,
            "format": "󰾆 {used}GB",
            "rotate": 0,
            "format-m": "󰾅 {used}GB",
            "format-h": "󰓅 {used}GB",
            "format-c": " {used}GB",
            "format-alt": "󰾆 {percentage}%",
            "max-length": 10,
            "tooltip": true,
            "tooltip-format": "󰾆 {percentage}%\n {used:0.1f}GB/{total:0.1f}GB"
        },
    
        "custom/cpuinfo": {
            "exec": " $HOME/.config/waybar/scripts/lib/cpuinfo.sh",
            "return-type": "json",
            "format": "{}",
            "rotate": 0,
            "interval": 5, // once every 5 seconds
            "tooltip": true,
            "max-length": 1000
        },
    
        "custom/gpuinfo": {
            "exec": "$HOME/.config/waybar/scripts/lib/gpuinfo.sh",
            "return-type": "json",
            "format": "{}",
            "rotate": 0,
            "interval": 5, // once every 5 seconds
            "tooltip": true,
            "max-length": 1000,
            "on-click": "$HOME/.config/waybar/scripts/lib/gpuinfo.sh --toggle"
        },
    
        "custom/gpuinfo#nvidia": {
            "exec": "$HOME/.config/waybar/scripts/lib/gpuinfo.sh --use nvidia ",
            "return-type": "json",
            "format": "{}",
            "rotate": 0,
            "interval": 5, // once every 5 seconds
            "tooltip": true,
            "max-length": 1000
        },
    
        "custom/gpuinfo#amd": {
            "exec": "$HOME/.config/waybar/scripts/lib/gpuinfo.sh --use amd ",
            "return-type": "json",
            "format": "{}",
            "rotate": 0,
            "interval": 5, // once every 5 seconds
            "tooltip": true,
            "max-length": 1000,
        },
    
        "custom/gpuinfo#intel": {
            "exec": " $HOME/.config/waybar/scripts/lib/gpuinfo.sh --use intel ",
            "return-type": "json",
            "format": "{}",
            "rotate": 0,
            "interval": 5, // once every 5 seconds
            "tooltip": true,
            "max-length": 1000,
        },
    
        "idle_inhibitor": {
            "format": "{icon}",
            "rotate": 0,
            "format-icons": {
                "activated": "󰅶 ",
                "deactivated": "󰛊 "
            },
            "tooltip-format-activated":"Caffeine Mode Active",
            "tooltip-format-deactivated":"Caffeine Mode Inactive"
        },
        "clock": {
            "format": "{:%I:%M %p}",
            "rotate": 0,
            "format-alt": "{:%R 󰃭 %d·%m·%y}",
            "tooltip-format": "<span>{calendar}</span>",
            "calendar": {
                "mode": "month",
                "mode-mon-col": 3,
                "on-scroll": 1,
                "on-click-right": "mode",
                "format": {
                    "months": "<span color='#ffead3'><b>{}</b></span>",
                    "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
                    "today": "<span color='#ff6699'><b>{}</b></span>"
                }
            },
            "actions": {
                "on-click-right": "mode",
                "on-click-forward": "tz_up",
                "on-click-backward": "tz_down",
                "on-scroll-up": "shift_up",
                "on-scroll-down": "shift_down"
            }
        },
    
        "niri/workspaces": {
            "rotate": 0,
            "all-outputs": false,
            "format": "{value}"
        },
    
        "niri/window": {
            "format": "  {}",
            "rotate": 0,
            "separate-outputs": true,
            "rewrite": {
                "khing@archlinux:(.*)": "$1 ",
                "(.*) — Mozilla Firefox": "$1 󰈹",
                "(.*)Mozilla Firefox": "Firefox 󰈹",
                "(.*) - Visual Studio Code": "$1 󰨞",
                "(.*)Visual Studio Code": "Code 󰨞",
                "(.*) - Code - OSS": "$1 󰨞",
                "(.*)Code - OSS": "Code 󰨞",
                "(.*) — Dolphin": "$1 󰉋",
                "(.*)Spotify": "Spotify 󰓇",
                "(.*)Steam": "Steam 󰓓",
                "(.*) - Discord": "$1  ",
                "(.*)Netflix": "Netflix 󰝆 ",
                "(.*) — Google chrome": "$1  ",
                "(.*)Google chrome": "Google chrome  ",
                "(.*) — Github": "$1  ",
                "(.*)Github": "Github ",
                "(.*)Spotify Free": "Spotify 󰓇",
                "(.*)Spotify Premiun": "Spotify 󰓇",
            },
            "max-length": 50
        },
    
        // "backlight" eliminado: este equipo no tiene /sys/class/backlight/ (es un desktop).

        "network": {
            "tooltip": true,
            "format-wifi": " ",
            "rotate": 0,
            "format-ethernet": "󰈀 ",
            "tooltip-format": "Network: <big><b>{essid}</b></big>\nSignal strength: <b>{signaldBm}dBm ({signalStrength}%)</b>\nFrequency: <b>{frequency}MHz</b>\nInterface: <b>{ifname}</b>\nIP: <b>{ipaddr}/{cidr}</b>\nGateway: <b>{gwaddr}</b>\nNetmask: <b>{netmask}</b>",
            "format-linked": "󰈀 {ifname} (No IP)",
            "format-disconnected": "󰖪 ",
            "tooltip-format-disconnected": "Disconnected",
            "format-alt": "<span foreground='#99ffdd'> {bandwidthDownBytes}</span> <span foreground='#ffcc66'> {bandwidthUpBytes}</span>",
            "interval": 2,
        },
    
    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "rotate": 0,
        "format-muted": "婢",
        "on-click": "pavucontrol-qt",
        "on-click-right": "$HOME/.config/waybar/scripts/lib/volumecontrol.sh -s ''",
        "on-click-middle": "$HOME/.config/waybar/scripts/lib/volumecontrol.sh -o m",
        "on-scroll-up": "$HOME/.config/waybar/scripts/lib/volumecontrol.sh -o i",
        "on-scroll-down": "$HOME/.config/waybar/scripts/lib/volumecontrol.sh -o d",
        "tooltip-format": "{icon} {desc} {volume}%",
        "scroll-step": 5,
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        }
    },
    
    
    "pulseaudio#microphone": {
        "format": "{format_source}",
        "rotate": 0,
        "format-source": "󰍬",
        "format-source-muted": "󰍭",
        "on-click": "pavucontrol-qt -t 4",
        "on-click-middle": "$HOME/.config/waybar/scripts/lib/volumecontrol.sh -i m",
        "on-scroll-up": "$HOME/.config/waybar/scripts/lib/volumecontrol.sh -i i",
        "on-scroll-down": "$HOME/.config/waybar/scripts/lib/volumecontrol.sh -i d",
        "tooltip-format": "{format_source} {source_desc} // {source_volume}%",
        "scroll-step": 5
    },

    "custom/updates": {
        "exec": "$HOME/.config/waybar/scripts/lib/systemupdate.sh",
        "return-type": "json",
        "format": "{}",
        "rotate": 0,
        "on-click": "hyprctl dispatch exec '$HOME/.config/waybar/scripts/lib/systemupdate.sh up'",
        "interval": 86400,
        "tooltip": true,
        "signal": 20
    },

    "custom/keybindhint": {
        "format": "",
        "tooltip-format": " Atajos de teclado (niri)",
        "rotate": 0,
        "on-click": "niri msg action show-hotkey-overlay"
    },

    "privacy": {
        "icon-size": 12,
        "icon-spacing": 5,
        "transition-duration": 250,
        "modules": [
            { "type": "screenshare", "tooltip": true, "tooltip-icon-size": 24 },
            { "type": "audio-in", "tooltip": true, "tooltip-icon-size": 24 }
        ]
    },

    "tray": {
        "icon-size": 16,
        "rotate": 0,
        "spacing": 6
    },

    // "battery" eliminado: la unica bateria es hidpp_battery_0 (raton Logitech)
    // y tiene scope=Device, que waybar ignora a proposito.

    "custom/cliphist": {
        "format": "{}",
        "rotate": 0,
        "exec": "echo ; echo 󰅇 clipboard history",
        "on-click": "sleep 0.1 && $HOME/.config/waybar/scripts/lib/cliphist.sh -c",
        "on-click-right": "sleep 0.1 && $HOME/.config/waybar/scripts/lib/cliphist.sh -d",
        "on-click-middle": "sleep 0.1 && $HOME/.config/waybar/scripts/lib/cliphist.sh -w",
        "interval" : 86400,
        "tooltip": true
    },

            "custom/power": {
            "format": "{}",
            "rotate": 0,
            "exec": "echo ; echo  logout",
            "on-click": "$HOME/.config/waybar/scripts/lib/logoutlaunch.sh 2",
            "on-click-right": "logoutlaunch.sh 1",
            "interval" : 86400, // once every day
            "tooltip": true
        },
    
    
    // modules for padding //
    
        "custom/l_end": {
            "format": " ",
            "interval" : "once",
            "tooltip": false
        },
    
        "custom/r_end": {
            "format": " ",
            "interval" : "once",
            "tooltip": false
        },
    
        "custom/sl_end": {
            "format": " ",
            "interval" : "once",
            "tooltip": false
        },
    
        "custom/sr_end": {
            "format": " ",
            "interval" : "once",
            "tooltip": false
        },
    
        "custom/rl_end": {
            "format": " ",
            "interval" : "once",
            "tooltip": false
        },
    
        "custom/rr_end": {
            "format": " ",
            "interval" : "once",
            "tooltip": false
        },
    
        "custom/padd": {
            "format": "  ",
            "interval" : "once",
            "tooltip": false
        }
    
    }
    
    

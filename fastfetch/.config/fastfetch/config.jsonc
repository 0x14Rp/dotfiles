{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // Si cambias la imagen del logo y no ves el cambio:  fastfetch --logo-recache
  "logo": {
    "type": "kitty",
    "source": "~/.config/fastfetch/images/hornet.png",
    "height": 15,
    "padding": { "top": 0, "right": 3 }
  },
  "display": { "separator": " : " },
  "modules": [
    {"type": "custom", "format": ""},
    { "type": "title",    "key": "  󰀉 User    ",     "format": "{6} {7} {8}", "keyColor": "38;5;175" },
    { "type": "os",       "key": "  󰣇 OS      ",       "format": "{2}", "keyColor": "38;5;139" },
    { "type": "kernel",   "key": "  󰌽 Kernel  ",   "format": "{2}", "keyColor": "38;5;109" },
    { "type": "packages", "key": "  󰏗 Packages", "keyColor": "38;5;108" },
    { "type": "display",  "key": "  󰍹 Display ",  "format": "{1}x{2} @ {3}Hz [{7}]", "keyColor": "38;5;175" },
    { "type": "wm",       "key": "  󱗃 WM      ",       "format": "{2}", "keyColor": "38;5;139" },
    { "type": "terminal", "key": "  󰆍 Terminal", "keyColor": "38;5;137" },
    { "type": "command",  "key": "  󱦟 OS Age  ",   "keyColor": "38;5;137",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); echo $(( (current - birth_install) / 86400 )) days" },
    { "type": "uptime",   "key": "  󱫐 Uptime  ",   "keyColor": "38;5;108" },
    { "type": "command",  "key": "  󰊤 GitHub  ",   "keyColor": "38;5;109", "text": "echo 0x14Rp" },
    "break",
    { "type": "cpu",    "key": "  󰻠 CPU     ",    "format": "{1}", "keyColor": "38;5;109" },
    { "type": "gpu",    "key": "  󰊴 GPU     ",    "hideType": "integrated", "format": "{2}", "keyColor": "38;5;139" },
    { "type": "memory", "key": "  󰘚 Memory  ", "keyColor": "38;5;137" },
    "break",
    { "type": "colors", "paddingLeft": 4, "symbol": "circle" },
    "break"
  ]
}
